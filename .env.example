# Project Config
PROJECT_NAME="University Portal Backend"
ENV="development"
DEBUG=true
API_V1_STR="/api/v1"

# CORS & Host Configuration (JSON array of strings)
BACKEND_CORS_ORIGINS='["http://localhost:3000", "http://localhost:5173"]'
ALLOWED_HOSTS='["localhost", "127.0.0.1"]'

# PostgreSQL Database Configuration (REQUIRED: set POSTGRES_PASSWORD in .env)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="change-me-strong-postgres-password"
POSTGRES_DB="university_cms"

# Redis Configuration
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0

# Security Config (REQUIRED in production: generate with `python -c "import secrets; print(secrets.token_hex(32))"`)
SECRET_KEY="generate-a-secure-32-byte-hex-string-for-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE="lax"

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="<green>{time:YYYY-MM-DD HH:mm:ss.SSS}</green> | <level>{level: <8}</level> | <cyan>{name}</cyan>:<cyan>{function}</cyan>:<cyan>{line}</cyan> - <level>{message}</level>"
LOG_FILE_PATH="logs/app.log"

# MinIO / S3 Storage Configuration (REQUIRED: set MINIO_ACCESS_KEY and MINIO_SECRET_KEY in .env)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="change-me-minio-access-key"
MINIO_SECRET_KEY="change-me-minio-secret-key"
MINIO_SECURE=false
MINIO_BUCKET="university-media"


# AI Config (REQUIRED for OmniRoute: set AI_API_KEY and LITELLM_MASTER_KEY in .env)
GEMINI_API_KEY=""
AI_PROVIDER="omniroute"
AI_BASE_URL="http://localhost:8090"
AI_API_KEY="change-me-omniroute-master-key"
LITELLM_MASTER_KEY="change-me-omniroute-master-key"
AI_DEFAULT_MODEL="gemini-2.5-flash"

# Translation Config (Local AI Model)
TRANSLATION_MODEL_NAME="facebook/nllb-200-distilled-1.3B"
TRANSLATION_DEVICE="auto"

# Chatbot (Grok chính, tự dự phòng sang Groq qua cổng LiteLLM)
# XAI_API_KEY phải được đặt trong môi trường của container omniroute (docker-compose.yml)
XAI_API_KEY=""
CHATBOT_MODEL="grok-chat"
CHATBOT_MAX_MESSAGE_CHARS=500
CHATBOT_RATE_LIMIT_PER_MIN=8
CHATBOT_HISTORY_TURNS=10
CHATBOT_SESSION_TTL_SECONDS=1800
CHATBOT_KNOWLEDGE_TTL_SECONDS=300
CHATBOT_MAX_OUTPUT_TOKENS=500
# Frontends to refresh right after an admin changes content (JSON list; leave empty to disable).
# Each token must equal that frontend's REVALIDATION_TOKEN.
# FRONTEND_REVALIDATE_TARGETS='[{"url":"http://frontend:3000/api/revalidate","token":"change-me"}]'
